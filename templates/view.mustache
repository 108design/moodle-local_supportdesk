{{! Derived from learn-ix Academic Ticket System; GPL-3.0-or-later. Modified 2026-10-03 by 108design: native Moodle UI. }}

<div class="supportdesk ats-container" data-ticket-id="{{ticketid}}">
<header class="mb-4"><h2 class="h4">#{{ticket.id}} · {{ticket.title}}</h2><p class="supportdesk-badges">{{#ticket.status_badge}}{{> local_supportdesk/badge}}{{/ticket.status_badge}}{{#ticket.priority_badge}}{{> local_supportdesk/badge}}{{/ticket.priority_badge}}{{#ticket.category_badge}}{{> local_supportdesk/badge}}{{/ticket.category_badge}}</p></header>
<section class="supportdesk-issue mb-4" aria-labelledby="ticket-description-heading"><h3 class="h5" id="ticket-description-heading">{{#str}}ticket_description_label, local_supportdesk{{/str}}</h3><div class="supportdesk-message">{{{ticket.description}}}</div>
{{#ticket.has_attachments}}<h4 class="h6 mt-3">{{#str}}attachments_heading, local_supportdesk{{/str}}</h4><ul class="list-unstyled supportdesk-attachments">{{#ticket.attachments}}{{> local_supportdesk/attachment}}{{/ticket.attachments}}</ul>{{/ticket.has_attachments}}</section>
<section class="mb-4" aria-labelledby="conversation-heading"><h3 class="h5" id="conversation-heading">{{#str}}conversation, local_supportdesk{{/str}}</h3>
{{#replies}}<article class="supportdesk-reply{{#is_manager_reply}} supportdesk-reply-support{{/is_manager_reply}}"><header class="supportdesk-toolbar mb-2"><div><strong>{{user}}</strong> <span class="small text-muted">{{#is_manager_reply}}{{#str}}support_team, local_supportdesk{{/str}}{{/is_manager_reply}}{{^is_manager_reply}}{{#str}}customer, local_supportdesk{{/str}}{{/is_manager_reply}}</span></div><span class="small text-muted">{{time}}</span></header>
<div class="supportdesk-message">{{{message}}}</div>{{#has_reply_attachments}}<ul class="list-unstyled supportdesk-attachments mt-3">{{#reply_attachments}}{{> local_supportdesk/attachment}}{{/reply_attachments}}</ul>{{/has_reply_attachments}}</article>{{/replies}}
{{^replies}}<p class="text-muted">{{#str}}no_replies_message, local_supportdesk{{/str}}</p>{{/replies}}</section>
{{^ticket.status_closed}}<section class="supportdesk-compose"><h3 class="h5" id="reply-heading">{{#str}}add_reply_heading, local_supportdesk{{/str}}</h3>
<form method="post" action="view.php?id={{ticket.id}}" enctype="multipart/form-data" class="supportdesk-form"><input type="hidden" name="sesskey" value="{{sesskey}}">
<div class="form-group mb-3"><label for="reply_message">{{#str}}write_your_reply, local_supportdesk{{/str}} *</label><textarea class="form-control" id="reply_message" data-supportdesk-paste aria-describedby="reply_message-paste-hint" name="reply_message" rows="5" required></textarea><p class="small text-muted mt-1 mb-0" id="reply_message-paste-hint">{{#str}}paste_image_hint, local_supportdesk{{/str}}</p></div>
{{> local_supportdesk/voice}}{{> local_supportdesk/files}}<button type="submit" class="btn btn-primary">{{#str}}send_reply_button, local_supportdesk{{/str}}</button></form></section>{{/ticket.status_closed}}
{{#can_rate}}<section class="border-top mt-4 pt-3"><h3 class="h5">{{#str}}experience_question, local_supportdesk{{/str}}</h3><form method="post" action="view.php?id={{ticket.id}}&amp;action=submit_feedback"><input type="hidden" name="sesskey" value="{{sesskey}}">
<label for="feedback-rating">{{#str}}rating_label, local_supportdesk{{/str}}</label><select name="rating" id="feedback-rating" class="form-control mb-3" required><option value="">{{#str}}choose_rating, local_supportdesk{{/str}}</option>{{#rating_options}}<option value="{{val}}">{{val}} / 5</option>{{/rating_options}}</select>
<label for="feedback-comment">{{#str}}feedback_comment_label, local_supportdesk{{/str}}</label><textarea class="form-control mb-3" id="feedback-comment" name="feedback_comment" rows="3"></textarea><button class="btn btn-primary" type="submit">{{#str}}submit_feedback, local_supportdesk{{/str}}</button></form></section>{{/can_rate}}
{{#has_feedback}}<section class="border-top mt-4 pt-3"><h3 class="h5">{{#str}}feedback_submitted, local_supportdesk{{/str}}</h3><p>{{feedback_data.rating}} / 5</p><p>{{feedback_data.comment}}</p></section>{{/has_feedback}}
</div>
{{#js}}require(['local_supportdesk/forms', 'local_supportdesk/view_interactions'], function(forms, interactions) { forms.init(); interactions.init(); });{{/js}}
