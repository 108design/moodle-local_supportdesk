{{! Derived from learn-ix Academic Ticket System; GPL-3.0-or-later. Modified 2026-10-03 by 108design: native Moodle UI. }}

<div class="supportdesk">
<form method="post" action="view.php?id={{ticket.id}}&amp;action=update_status" class="mb-3"><input type="hidden" name="sesskey" value="{{sesskey}}"><label for="ticket-status">{{#str}}change_status_label, local_supportdesk{{/str}}</label><div class="supportdesk-field-action"><select class="form-control" id="ticket-status" name="status">{{#statuses}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/statuses}}</select><button type="submit" class="btn btn-outline-secondary supportdesk-iconbutton" title="{{#str}}update_status_button, local_supportdesk{{/str}}" aria-label="{{#str}}update_status_button, local_supportdesk{{/str}}">{{#pix}}e/save, core{{/pix}}</button></div></form>
<form method="post" action="view.php?id={{ticket.id}}&amp;action=update_category" class="mb-3"><input type="hidden" name="sesskey" value="{{sesskey}}"><label for="ticket-category">{{#str}}change_category_label, local_supportdesk{{/str}}</label><div class="supportdesk-field-action"><select class="form-control" id="ticket-category" name="categoryid">{{#categories}}<option value="{{id}}" {{#is_selected}}selected{{/is_selected}}>{{title}}</option>{{/categories}}</select><button type="submit" class="btn btn-outline-secondary supportdesk-iconbutton" title="{{#str}}update_category_button, local_supportdesk{{/str}}" aria-label="{{#str}}update_category_button, local_supportdesk{{/str}}">{{#pix}}e/save, core{{/pix}}</button></div></form>
<form method="post" action="view.php?id={{ticket.id}}&amp;action=assign_user"><input type="hidden" name="sesskey" value="{{sesskey}}"><label for="supportdesk-assignee-search">{{#str}}search_user_placeholder, local_supportdesk{{/str}}</label><input type="search" class="form-control mb-2" id="supportdesk-assignee-search" data-filter-assignees><label for="supportdesk-assignee">{{#str}}assign_user_label, local_supportdesk{{/str}}</label><div class="supportdesk-field-action"><select class="form-control" name="assigned_to" id="supportdesk-assignee"><option value="0">{{#str}}unassigned, local_supportdesk{{/str}}</option>{{#assignable_users}}<option value="{{id}}" {{#is_selected}}selected{{/is_selected}} data-search="{{fullname}} {{email}} {{username}}">{{fullname}} · {{email}}</option>{{/assignable_users}}</select><button type="submit" class="btn btn-outline-secondary supportdesk-iconbutton" title="{{#str}}assign_user, local_supportdesk{{/str}}" aria-label="{{#str}}assign_user, local_supportdesk{{/str}}">{{#pix}}i/assignroles, core{{/pix}}</button></div></form>
</div>
