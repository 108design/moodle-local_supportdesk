{{! Derived from learn-ix Academic Ticket System; GPL-3.0-or-later. Modified 2026-10-03 by 108design: native Moodle UI. }}

<li class="supportdesk-attachment{{#is_image}} supportdesk-attachment-image{{/is_image}}">
{{#is_image}}<a class="supportdesk-thumbnail" href="{{url}}" data-ticket-image data-image-width="{{width}}" data-image-height="{{height}}" data-image-name="{{name}}"><img src="{{thumbnail_url}}" alt="{{name}}" loading="lazy" decoding="async"><span>{{name}}</span></a>{{/is_image}}
{{^is_image}}<a href="{{download_url}}">{{#pix}}f/document, core{{/pix}}{{name}}</a>{{/is_image}}
{{#is_audio}}<audio controls class="d-block mt-1" preload="none" src="{{url}}" aria-label="{{name}}"></audio>{{/is_audio}}
</li>
