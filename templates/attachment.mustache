<li class="mb-2"><a href="{{url}}">{{#pix}}f/document, core{{/pix}}{{name}}</a>
{{#is_image}}<button type="button" class="btn btn-link p-1" data-preview-image="{{url}}" data-preview-title="{{name}}">{{#str}}view, local_supportdesk{{/str}}</button>{{/is_image}}
{{#is_audio}}<audio controls class="d-block mt-1" preload="none" src="{{url}}" aria-label="{{name}}"></audio>{{/is_audio}}
</li>
