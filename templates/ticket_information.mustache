<div class="supportdesk"><dl class="supportdesk-facts"><dt>{{#str}}user_name_label, local_supportdesk{{/str}}</dt><dd>{{#ticket.creator_profile_url}}<a href="{{ticket.creator_profile_url}}">{{ticket.created_by}}</a>{{/ticket.creator_profile_url}}{{^ticket.creator_profile_url}}{{#ticket.public_contact}}{{name}}{{/ticket.public_contact}}{{^ticket.public_contact}}{{ticket.created_by}}{{/ticket.public_contact}}{{/ticket.creator_profile_url}}</dd><dt>{{#str}}created_at, local_supportdesk{{/str}}</dt><dd>{{ticket.created_at}}</dd><dt>{{#str}}assigned_to, local_supportdesk{{/str}}</dt><dd>{{assigned_user_name}}</dd></dl>{{#ticket.public_contact}}<p class="small mb-1">{{#str}}public_origin, local_supportdesk{{/str}}</p><p class="small mb-1">{{email}}</p>{{#unclaimed}}<p class="small text-muted">{{#str}}public_unverified, local_supportdesk{{/str}}</p>{{/unclaimed}}{{/ticket.public_contact}}</div>
