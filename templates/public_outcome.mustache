<section class="supportdesk supportdesk-public-panel" aria-labelledby="supportdesk-public-heading">
<h1 class="h3 mb-3" id="supportdesk-public-heading">{{heading}}</h1>
<div class="alert {{#failed}}alert-warning{{/failed}}{{^failed}}alert-info{{/failed}}" role="{{#failed}}alert{{/failed}}{{^failed}}status{{/failed}}">{{notice}}</div>
{{#canclaim}}
<form method="post" action="{{actionurl}}">
<input type="hidden" name="sesskey" value="{{sesskey}}">
<button type="submit" class="btn btn-primary">{{#str}}public_claim, local_supportdesk{{/str}}</button>
</form>
{{/canclaim}}
<div class="supportdesk-public-actions">
{{#failed}}{{#retryurl}}<a class="btn btn-secondary" href="{{retryurl}}">{{#str}}public_claim_retry, local_supportdesk{{/str}}</a>{{/retryurl}}{{/failed}}
{{#ticketsurl}}<a class="btn btn-link" href="{{ticketsurl}}">{{#str}}all_tickets, local_supportdesk{{/str}}</a>{{/ticketsurl}}
{{#loginurl}}<a class="btn btn-primary" href="{{loginurl}}">{{#str}}public_login, local_supportdesk{{/str}}</a>{{/loginurl}}
</div>
</section>
