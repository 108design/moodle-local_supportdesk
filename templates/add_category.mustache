{{! Derived from learn-ix Academic Ticket System; GPL-3.0-or-later. Modified 2026-10-03 by 108design: native Moodle UI. }}

<div class="supportdesk ats-container">
{{#has_alert}}<div class="alert {{#alert_success}}alert-success{{/alert_success}}{{^alert_success}}alert-danger{{/alert_success}}" role="status">{{alert.message}}</div>{{/has_alert}}
<h2 class="h4">{{#editing}}{{#str}}edit_department, local_supportdesk{{/str}}{{/editing}}{{^editing}}{{#str}}add_new_department, local_supportdesk{{/str}}{{/editing}}</h2>
<form action="{{action_url}}" method="post" class="supportdesk-form mb-4"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="{{#editing}}edit{{/editing}}{{^editing}}add{{/editing}}">{{#editing}}<input type="hidden" name="id" value="{{edit.id}}">{{/editing}}
<div class="form-group mb-3"><label for="title">{{#str}}category_title, local_supportdesk{{/str}} *</label><input class="form-control" id="title" name="title" value="{{edit.title}}" required maxlength="255"></div>
<div class="form-group mb-3"><label for="description">{{#str}}description_optional, local_supportdesk{{/str}}</label><textarea class="form-control" id="description" name="description" rows="3">{{edit.description}}</textarea></div>
<div class="form-group mb-3"><label for="category-color">{{#str}}badge_color, local_supportdesk{{/str}}</label><input type="color" class="form-control supportdesk-color-input" id="category-color" name="color" value="{{color}}" aria-describedby="category-color-hint"><p class="small text-muted mt-1" id="category-color-hint">{{#str}}badge_color_help, local_supportdesk{{/str}}</p></div>
<fieldset class="mb-3"><legend class="supportdesk-field-label">{{#str}}department_team, local_supportdesk{{/str}}</legend>
<p class="small text-muted">{{#str}}department_team_help, local_supportdesk{{/str}}</p>
{{#team_options}}<div class="form-check"><input class="form-check-input" type="checkbox" name="members[]" value="{{id}}" id="team-member-{{id}}" {{#selected}}checked{{/selected}}><label class="form-check-label supportdesk-team-member" for="team-member-{{id}}">{{name}}</label></div>{{/team_options}}
{{^has_team_options}}<p class="small text-muted">{{#str}}department_team_empty, local_supportdesk{{/str}}</p>{{/has_team_options}}</fieldset>
<button class="btn btn-primary" type="submit">{{#str}}save_department, local_supportdesk{{/str}}</button>{{#editing}} <a href="{{action_url}}" class="btn btn-secondary">{{#str}}cancel, local_supportdesk{{/str}}</a>{{/editing}}</form>
<h2 class="h4">{{#str}}existing_departments, local_supportdesk{{/str}}</h2><div class="table-responsive"><table class="table table-striped table-hover"><thead><tr><th scope="col">{{#str}}category_title, local_supportdesk{{/str}}</th><th scope="col">{{#str}}description, local_supportdesk{{/str}}</th><th scope="col">{{#str}}department_team, local_supportdesk{{/str}}</th><th scope="col">{{#str}}created_by, local_supportdesk{{/str}}</th><th scope="col">{{#str}}created_at, local_supportdesk{{/str}}</th><th scope="col">{{#str}}actions, local_supportdesk{{/str}}</th></tr></thead><tbody>
{{#categories}}<tr><td>{{#badge}}{{> local_supportdesk/badge}}{{/badge}}</td><td>{{description}}</td><td>{{team_names}}{{^team_names}}–{{/team_names}}</td><td>{{created_by}}</td><td>{{created_at}}</td><td class="supportdesk-actions"><a href="{{action_url}}?editid={{id}}" class="supportdesk-action-link" title="{{#str}}edit_department, local_supportdesk{{/str}}" aria-label="{{#str}}edit_department, local_supportdesk{{/str}}: {{title}}">{{#pix}}t/edit, core{{/pix}}</a>
<form action="{{action_url}}" method="post" class="d-inline" data-confirm-delete><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="{{id}}"><button type="submit" class="supportdesk-action-link" title="{{#str}}delete_department, local_supportdesk{{/str}}" aria-label="{{#str}}delete_department, local_supportdesk{{/str}}: {{title}}">{{#pix}}t/delete, core{{/pix}}</button></form></td></tr>{{/categories}}
{{^categories}}<tr><td colspan="6">{{#str}}no_departments, local_supportdesk{{/str}}</td></tr>{{/categories}}</tbody></table></div></div>
{{#js}}require(['local_supportdesk/category_alert'], function(module) { module.init(); });{{/js}}

