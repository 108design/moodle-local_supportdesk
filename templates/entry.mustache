{{#hasmagiclink}}<section class="mb-4"><p>{{#str}}visitor_intro, local_supportdesk{{/str}}</p>
<p><a class="btn btn-primary" href="{{magiclinkurl}}">{{#str}}visitor_continue, local_supportdesk{{/str}}</a></p>
