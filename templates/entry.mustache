{{/hasmagiclink}}<section class="border-top pt-3"><p>{{#str}}visitor_login_help, local_supportdesk{{/str}}</p><a class="btn btn-secondary" href="{{loginurl}}">{{#str}}visitor_standardlogin, local_supportdesk{{/str}}</a></section>
</div>
